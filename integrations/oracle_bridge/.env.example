# NÃO preencha este arquivo com valores reais no GitHub.
UFMS_TUTOR_BOT_TOKEN=REPLACE_ON_ORACLE
UFMS_COACH_BOT_TOKEN=REPLACE_ON_ORACLE
UFMS_ALLOWED_TELEGRAM_USER_ID=REPLACE_NUMERIC_ID
UFMS_SQLITE_PATH=/data/ufms-bridge.sqlite3
# A integração ao ChatGPT NÃO concede estes tokens ao serviço Oracle.
# Configurar OAuth Google offline, consentimento e escopo restrito.
# UFMS_GOOGLE_CLIENT_ID=
# UFMS_GOOGLE_CLIENT_SECRET=
# UFMS_GOOGLE_REFRESH_TOKEN=
# UFMS_GOOGLE_CALENDAR_ID=

# Gemini Developer API: DESATIVADA por padrão.
# O ChatGPT Plus e o Gemini Notebook NÃO fornecem credenciais para esta API.
# ATENÇÃO: projeto Google Free Tier e política precisam ser verificados pelo operador.
UFMS_LLM_ENABLED=0
# UFMS_LLM_PROVIDER=gemini
# UFMS_GEMINI_FREE_PROJECT_ATTESTED=0
# UFMS_GEMINI_PRIVACY_REVIEWED=0
# UFMS_GEMINI_API_KEY=
# UFMS_GEMINI_MODEL=gemini-3.5-flash-lite
# UFMS_LLM_DAILY_LIMIT=10
# Não configurar API OpenAI com cobrança no modo custo zero.

# Mensagens periódicas não personalizadas, também dependem de /ativar_alertas
# UFMS_GENERIC_CHECKINS=0
