{
  "schema_version": "1.0",
  "nota": "Esquema versionado dos comandos de Tutor e Coach para a Zapia (PR-013, S4-R1). Validação offline em scripts/agent_commands.py. As operações por perfil devem coincidir com scripts/agents_gate.py.",
  "required_fields": ["schema_version", "origin", "operation", "destination", "params", "idempotency_key", "nonce", "issued_at", "signature"],
  "origins": ["tutor", "coach"],
  "destinations": {
    "ler_arquivo_repositorio": "repo_publico_leitura",
    "enviar_mensagem": "proprietario",
    "registrar_resultado": "repo_privado_dados",
    "registrar_exportacao_desempenho": "repo_privado_dados",
    "registrar_plano": "repo_privado_dados",
    "registrar_acompanhamento": "repo_privado_dados",
    "enviar_prompt_notebook": "notebook_estudo",
    "criar_lembrete": "agenda_proprietario",
    "consultar_agenda_minima": "agenda_proprietario"
  },
  "limits": {
    "max_command_bytes": 16384,
    "max_param_string_chars": 2000,
    "max_param_depth": 4,
    "time_window_seconds": 120,
    "idempotency_key_pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "nonce_pattern": "^[A-Za-z0-9._:-]{16,128}$"
  },
  "forbidden_param_keys": ["senha", "password", "token", "secret", "segredo", "cookie", "authorization", "credencial", "cpf", "api_key", "enunciado", "texto_questao", "alternativas", "html", "screenshot"]
}
