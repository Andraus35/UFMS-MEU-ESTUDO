{
  "schema_version": "0.2.0",
  "project": "UFMS-MEU-ESTUDO",
  "agent": {
    "mode": "adaptive",
    "human_in_the_loop": true
  },
  "bootstrap": {
    "mandatory": [
      "AGENTS.md",
      "ROADMAP.md",
      "memory/HANDOFF.md",
      "state/CURRENT.json"
    ],
    "engineering_mandatory": [
      "AGENTS.md",
      "ROADMAP.md",
      "PRODUCT.md",
      "memory/HANDOFF.md",
      "state/CURRENT.json",
      "state/WORKFLOW.json"
    ],
    "target_tokens": 2200
  },
  "context": {
    "load_history_on_demand": true,
    "checkpoint_after_meaningful_change": true,
    "never_assume_persistence": true
  },
  "study": {
    "fixed_schedule": false,
    "fixed_repetition_intervals": false,
    "owner_default_plan": {
      "decision": "D-11",
      "method": "4.2",
      "cycle": {
        "theory_days": 4,
        "review_days": 2,
        "rest_days": 1
      },
      "max_minutes_per_discipline_theory": 120,
      "review_intervals_days": [7, 15, 30],
      "adjustable_with_justification": true
    },
    "adaptive_blocks": true,
    "require_result_evidence": true
  },
  "storage": {
    "repository_must_be_private_for_personal_results": true,
    "personal_results_writes_enabled": false,
    "events_directory": "state/events",
    "state_file": "state/CURRENT.json",
    "progress_file": "state/PROGRESS.csv"
  },
  "source_priority": [
    "edital_e_retificacoes",
    "legislacao_e_normas_vigentes_no_edital",
    "gabarito_oficial_da_questao",
    "comentario_docente_verificado",
    "explicacao_ia_identificada"
  ],
  "hooks": {
    "native_registration_required": true,
    "before_write": "hooks/before_write.py",
    "after_write": "hooks/after_write.py",
    "checkpoint": "hooks/checkpoint.py"
  },
  "sources": {
    "canonical_edital": "EDITAL_UFMS_152_2026.md",
    "retrieval_index": "edital/INDEX.md",
    "manifest": "edital/manifest.json",
    "policy": "route-by-page; BM25 if needed; top-k 3-5; inspect original; expand on ambiguity"
  }
}
